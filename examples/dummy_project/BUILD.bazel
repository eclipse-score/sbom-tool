load("@rules_python//python:defs.bzl", "py_test")
load("@score_sbom//:defs.bzl", "sbom")

package(default_visibility = ["//visibility:public"])

exports_files(["MODULE.bazel.lock"])

# End-to-end smoke test for the SBOM rules: builds one SBOM covering both the
# C++ and the Rust dummy binaries, in SPDX 2.3 and CycloneDX 1.6.
#
# Outputs (in bazel-bin/):
#   dummy_sbom.spdx.json
#   dummy_sbom.cdx.json
sbom(
    name = "dummy_sbom",
    # Disable metadata downloads for this test. Bazel may still need to
    # download dependencies and toolchains on the first build.
    auto_cdxgen = False,
    auto_crates_cache = False,
    auto_registry_cache = False,
    component_name = "score_sbom_dummy_project",
    component_version = "0.1.0",
    generation_context = "build",
    module_lockfiles = [":MODULE.bazel.lock"],
    output_formats = [
        "spdx",
        "cyclonedx",
    ],
    targets = [
        "//cpp:app",
        "//rust:app",
    ],
)

# Asserts that the SBOMs built above are structurally valid and cover both the
# C++ and the Rust dependency chains.
py_test(
    name = "sbom_test",
    srcs = ["sbom_test.py"],
    data = [":dummy_sbom"],
)

# Opt-in smoke test for the auto_cdxgen Node-toolchain execution path. Kept
# separate from dummy_sbom/sbom_test above (and tagged "manual") because it
# needs real network access to resolve the Node toolchain and npm-exec the
# pinned cdxgen package, unlike the rest of this hermetic no-network build.
# Run explicitly with:
#   bazel test --test_tag_filters=-manual //:cdxgen_smoke_test
sbom(
    name = "dummy_sbom_cdxgen_smoke",
    auto_cdxgen = True,
    auto_crates_cache = False,
    component_name = "score_sbom_dummy_project_cdxgen_smoke",
    component_version = "0.1.0",
    module_lockfiles = [":MODULE.bazel.lock"],
    output_formats = ["cyclonedx"],
    tags = [
        "manual",
        "requires-network",
    ],
    targets = ["//cpp:app"],
)

py_test(
    name = "cdxgen_smoke_test",
    srcs = ["cdxgen_smoke_test.py"],
    data = [":dummy_sbom_cdxgen_smoke"],
    tags = [
        "manual",
        "requires-network",
    ],
)

# Test registry downloads and archive hashes in both output formats.
sbom(
    name = "dummy_sbom_registry_smoke",
    auto_crates_cache = False,
    component_name = "score_sbom_dummy_project",
    component_version = "0.1.0",
    module_lockfiles = [":MODULE.bazel.lock"],
    tags = [
        "manual",
        "requires-network",
    ],
    targets = ["//cpp:app"],
)

py_test(
    name = "registry_smoke_test",
    srcs = ["registry_smoke_test.py"],
    data = [":dummy_sbom_registry_smoke"],
    tags = [
        "manual",
        "requires-network",
    ],
)
