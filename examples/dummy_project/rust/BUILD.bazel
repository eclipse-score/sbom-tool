load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Every crate dependency resolves through @score_crates, the curated crate set
# from the eclipse-score Bazel registry. Nothing is fetched from crates.io here.
rust_library(
    name = "dummy_greeter",
    srcs = ["src/lib.rs"],
    edition = "2021",
    deps = [
        "@score_crates//:anyhow",
        "@score_crates//:serde",
        "@score_crates//:serde_json",
    ],
)

rust_binary(
    name = "app",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":dummy_greeter",
        "@score_crates//:anyhow",
    ],
)

rust_test(
    name = "dummy_greeter_test",
    crate = ":dummy_greeter",
    edition = "2021",
)
